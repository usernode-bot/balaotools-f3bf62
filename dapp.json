{
  "description": "Turn images into vector files the group can download",
  "icon": {
    "emoji": "🖼️"
  },
  "tests": [
    {
      "id": "main",
      "name": "Main screen",
      "path": "/",
      "viewport": { "width": 390, "height": 844 },
      "impact": ["public/**", "styles/**"],
      "expectSelector": "#choose-image",
      "expectText": "Choose an image to trace",
      "allowConsoleErrors": true
    },
    {
      "id": "demo",
      "name": "Staging demo screen",
      "path": "/?demo=1",
      "visual": true,
      "viewport": { "width": 390, "height": 844 },
      "impact": ["public/**", "styles/**"],
      "expectText": "balloon-logo.png",
      "allowConsoleErrors": true
    }
  ],
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  }
}